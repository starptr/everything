{
  "name": "papyrus",
  "version": "1.2.1",
  "description": "Canvas GUI frontend for silverwood workstreams (vendored from Fallomai/openui)",
  "author": "Fallom AI (upstream openui); vendored/rebranded as papyrus",
  "license": "MIT",
  "keywords": [
    "ai",
    "coding-agent",
    "claude-code",
    "opencode",
    "terminal",
    "canvas",
    "ui"
  ],
  "type": "module",
  "bin": {
    "papyrus": "./bin/papyrus.ts"
  },
  "files": [
    "bin/",
    "server/",
    "client/dist/",
    "README.md"
  ],
  "scripts": {
    "start": "bun run server/index.ts",
    "dev": "concurrently \"bun run --watch server/index.ts\" \"bun run --cwd client dev\"",
    "build": "bun run --cwd client build",
    "prepublishOnly": "bun run build",
    "install:client": "cd client && bun install",
    "test:server": "bun test server-tests"
  },
  "dependencies": {
    "bun-pty": "^0.4.8",
    "hono": "^4.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.6",
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  }
}
