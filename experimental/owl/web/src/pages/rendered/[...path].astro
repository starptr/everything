---
import ViewToggle from '../../components/ViewToggle.astro';
import Shell from '../../layouts/Shell.astro';
import { files, navHash, type FileEntry } from '../../lib/manifest';
import { renderRenderedHtml } from '../../lib/render';

export function getStaticPaths() {
  // cacheKey = path (unique) + navHash (sidebar) + hash (this file's body); changes
  // only when this page's output would, so unchanged pages are copied from cache.
  return files.map((entry) => ({
    params: { path: entry.path },
    props: { entry },
    cacheKey: `${entry.path}:${navHash}:${entry.hash}`,
  }));
}

const { entry } = Astro.props as { entry: FileEntry };
const html = await renderRenderedHtml(entry);
---

<Shell path={entry.path} view="rendered">
  <ViewToggle slot="toolbar" path={entry.path} view="rendered" />
  <div class="owl-file-view owl-rendered" set:html={html} />
</Shell>
